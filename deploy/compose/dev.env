# Development values for the Compose `dev` profile (ADR 0072, ADR 0052). `make dev`,
# `make dev-down` and CI's compose job pass `--env-file deploy/compose/dev.env`; compose.yaml
# itself defaults to production values. A pilot never uses this file: it sets the variables of
# docs/install/compose-pilot.md "Login" in its own .env.
#
# Dex runs under the console origin at /dex; the api reaches it over the core network through
# the plain-HTTP back-channel. Dex's static users carry no groups, so roles bind by email.
CARTO_OIDC_ISSUER=https://localhost:8080/dex
CARTO_OIDC_BACKCHANNEL_URL=http://dex:5556/dex
CARTO_OIDC_ALLOW_HTTP=true
CARTO_OIDC_GROUPS_CLAIM=email
CARTO_OIDC_GROUP_ROLES='{"admin@carto.local":"admin","engineer@carto.local":"integration_engineer","viewer@carto.local":"business_viewer","auditor@carto.local":"auditor"}'
